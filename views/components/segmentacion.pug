// VISTA SEGMENTACIÓN CLIENTE
section#segmentacion.vista
  h3 Módulo de segmentación de cliente
  form.formulario(onsubmit="return false;")
    .campo
      label(for="segCliente") Cliente
      select#segCliente
        option Seleccionar cliente
        option Carlos Pérez
    .campo
      label(for="segTipo") Tipo de segmento
      input#segTipo(type="text", placeholder="Ejemplo VIP, frecuente, nuevo")
    .campo
      label(for="segValor") Valor
      input#segValor(type="text", placeholder="Alto, medio, bajo")
    .campo
      label(for="segFecha") Fecha de clasificación
      input#segFecha(type="date")
  .botones
    button.boton.primario(type="button")
      | Guardar segmentación
    button.boton.secundario(type="button") Limpiar
  table
    thead
      tr
        th ID segmento
        th Cliente
        th Tipo de segmento
        th Valor
        th Fecha de clasificación
    tbody
      tr
        td 1
        td Carlos Pérez
        td VIP
        td Alto
        td 2025-12-05