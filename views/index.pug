extends layout

block content
  .layout
    aside.sidebar
      div
        h1 Proyecto Conecta Atlantic City
        ul.menu
          if userViews.includes('dashboard')
            li
              button.activo(data-vista="dashboard") Inicio
          if userViews.includes('clientes')
            li
              button(data-vista="clientes") Clientes
          if userViews.includes('puntos')
            li
              button(data-vista="puntos") Puntos de cliente
          if userViews.includes('segmentacion')
            li
              button(data-vista="segmentacion") Segmentación de cliente
          if userViews.includes('servicios')
            li
              button(data-vista="servicios") Servicios
          if userViews.includes('reservas')
            li
              button(data-vista="reservas") Reservas
          if userViews.includes('pagos')
            li
              button(data-vista="pagos") Pagos
          if userViews.includes('juegos')
            li
              button(data-vista="juegos") Juegos
          if userViews.includes('transacciones')
            li
              button(data-vista="transacciones") Transacciones de juego
          if userViews.includes('promociones')
            li
              button(data-vista="promociones") Promociones
          if userViews.includes('reclamos')
            li
              button(data-vista="reclamos") Reclamos
          if userViews.includes('personal')
            li
              button(data-vista="personal")
                | Usuarios y Auditoría
      .sidebar-footer
        if user
          p Usuario: #{user.usuario}
        a(href="/users/logout") Cerrar Sesión
    main.content
      header
        h2 Panel principal
        p Interfaz de ejemplo basada en el diseño de la base de datos
      // TARJETAS RESUMEN
      .tarjetas
        .tarjeta
          h3 Clientes registrados
          p 123
        .tarjeta
          h3 Reservas del día
          p 8
        .tarjeta
          h3 Pagos del día
          p S/ 950
        .tarjeta
          h3 Reclamos abiertos
          p 3
      // VISTAS (COMPONENTES)
      if userViews.includes('dashboard')
        include components/dashboard.pug
      if userViews.includes('clientes')
        include components/clientes.pug
      if userViews.includes('puntos')
        include components/puntos.pug
      if userViews.includes('segmentacion')
        include components/segmentacion.pug
      if userViews.includes('servicios')
        include components/servicios.pug
      if userViews.includes('reservas')
        include components/reservas.pug
      if userViews.includes('pagos')
        include components/pagos.pug
      if userViews.includes('juegos')
        include components/juegos.pug
      if userViews.includes('transacciones')
        include components/transacciones.pug
      if userViews.includes('promociones')
        include components/promociones.pug
      if userViews.includes('reclamos')
        include components/reclamos.pug
      if userViews.includes('personal')
        include components/personal.pug
  script.
    // cambio de vistas
    const botones = document.querySelectorAll(".menu button");
    const vistas = document.querySelectorAll(".vista");

    botones.forEach((boton) => {
      boton.addEventListener("click", () => {
        const destino = boton.getAttribute("data-vista");

        botones.forEach((b) => b.classList.remove("activo"));
        boton.classList.add("activo");

        vistas.forEach((v) => {
          if (v.id === destino) {
            v.classList.add("activa");
          } else {
            v.classList.remove("activa");
          }
        });

        const titulo = document.querySelector("header h2");
        if (destino === "dashboard") {
          titulo.textContent = "Panel principal";
        } else {
          titulo.textContent = "Módulo " + destino;
        }
      });
    });