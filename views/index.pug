extends layout

block content
  .layout
    // BARRA LATERAL
    aside.sidebar
      h1 Proyecto Conecta Atlantic City
      ul.menu
        li
          button.activo(data-vista="dashboard") Inicio
        li
          button(data-vista="clientes") Clientes
        li
          button(data-vista="puntos") Puntos de cliente
        li
          button(data-vista="segmentacion") Segmentación de cliente
        li
          button(data-vista="servicios") Servicios
        li
          button(data-vista="reservas") Reservas
        li
          button(data-vista="pagos") Pagos
        li
          button(data-vista="juegos") Juegos
        li
          button(data-vista="transacciones") Transacciones de juego
        li
          button(data-vista="promociones") Promociones
        li
          button(data-vista="reclamos") Reclamos
        li
          button(data-vista="personal")
            | Usuarios y Auditoría
    // CONTENIDO PRINCIPAL
    main.content
      header
        h2 Panel principal
        p Interfaz de ejemplo basada en el diseño de la base de datos
      // TARJETAS RESUMEN
      .tarjetas
        .tarjeta
          h3 Clientes registrados
          p 123
        .tarjeta
          h3 Reservas del día
          p 8
        .tarjeta
          h3 Pagos del día
          p S/ 950
        .tarjeta
          h3 Reclamos abiertos
          p 3
      // VISTA INICIO
      section#dashboard.vista.activa
        h3 Bienvenido al sistema
        p(style="margin-top: 10px; font-size: 14px; color: #4b5563")
          | Esta pantalla representa el inicio del sistema. Desde el menú
          | lateral puedes ver la interfaz de cada módulo clientes, puntos,
          | segmentación, servicios, reservas, pagos, juegos, promociones,
          | reclamos, usuarios, auditoría y transacion_juego. Todo es solo
          | diseño visual, sin conexión a la base de datos.
      // VISTA CLIENTES
      section#clientes.vista
        h3 Módulo de clientes
        form.formulario
          .campo
            label(for="cliNombres") Nombres
            input#cliNombres(type="text", placeholder="Nombres del cliente")
          .campo
            label(for="cliApellidos") Apellidos
            input#cliApellidos(type="text", placeholder="Apellidos del cliente")
          .campo
            label(for="cliDocumento") DNI o pasaporte
            input#cliDocumento(type="text", placeholder="Documento de identidad")
          .campo
            label(for="cliTelefono") Teléfono
            input#cliTelefono(type="text", placeholder="Número de teléfono")
          .campo
            label(for="cliCorreo") Correo electrónico
            input#cliCorreo(type="email", placeholder="correo@ejemplo.com")
          .campo
            label(for="cliContra") Contraseña
            input#cliContra(type="password", placeholder="Contraseña")
        .botones
          button.boton.primario(type="button")
            | Guardar cliente
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID
              th Nombres
              th Documento
              th Teléfono
              th Correo
              th Acciones
          tbody
            tr
              td 1
              td Carlos Pérez
              td 12345678
              td 987654321
              td carlos@correo.com
              td Editar | Eliminar
      // VISTA PUNTOS CLIENTE
      section#puntos.vista
        h3 Módulo de puntos de cliente
        form.formulario
          .campo
            label(for="ptoCliente") Cliente
            select#ptoCliente
              option Seleccionar cliente
              option Carlos Pérez
          .campo
            label(for="ptoTotal") Puntos totales
            input#ptoTotal(type="number", placeholder="0")
        .botones
          button.boton.primario(type="button") Guardar puntos
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID puntos
              th Cliente
              th Puntos totales
              th Acciones
          tbody
            tr
              td 1
              td Carlos Pérez
              td 150
              td Editar | Eliminar
      // VISTA SEGMENTACIÓN CLIENTE
      section#segmentacion.vista
        h3 Módulo de segmentación de cliente
        form.formulario
          .campo
            label(for="segCliente") Cliente
            select#segCliente
              option Seleccionar cliente
              option Carlos Pérez
          .campo
            label(for="segTipo") Tipo de segmento
            input#segTipo(type="text", placeholder="Ejemplo VIP, frecuente, nuevo")
          .campo
            label(for="segValor") Valor
            input#segValor(type="text", placeholder="Alto, medio, bajo")
          .campo
            label(for="segFecha") Fecha de clasificación
            input#segFecha(type="date")
        .botones
          button.boton.primario(type="button")
            | Guardar segmentación
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID segmento
              th Cliente
              th Tipo de segmento
              th Valor
              th Fecha de clasificación
          tbody
            tr
              td 1
              td Carlos Pérez
              td VIP
              td Alto
              td 2025-12-05
      // VISTA SERVICIOS
      section#servicios.vista
        h3 Módulo de servicios
        form.formulario
          .campo
            label(for="srvNombre") Nombre del servicio
            input#srvNombre(type="text", placeholder="Ejemplo sala de juegos")
          .campo
            label(for="srvPrecio") Precio
            input#srvPrecio(type="number", step="0.01", placeholder="0.00")
          .campo
            label(for="srvCapacidad") Capacidad
            input#srvCapacidad(type="number", placeholder="Cantidad de personas")
          .campo(style="grid-column: 1/3")
            label(for="srvDesc") Descripción
            textarea#srvDesc(placeholder="Descripción del servicio")
        .botones
          button.boton.primario(type="button")
            | Guardar servicio
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID
              th Servicio
              th Precio
              th Capacidad
              th Acciones
          tbody
            tr
              td 1
              td Sala de juegos familiar
              td S/ 50.00
              td 20
              td Editar | Eliminar
      // VISTA RESERVAS
      section#reservas.vista
        h3 Módulo de reservas
        form.formulario
          .campo
            label(for="resCliente") Cliente
            select#resCliente
              option Seleccionar cliente
              option Carlos Pérez
          .campo
            label(for="resServicio") Servicio
            select#resServicio
              option Seleccionar servicio
              option Sala de juegos familiar
          .campo
            label(for="resFecha") Fecha de reserva
            input#resFecha(type="date")
          .campo
            label(for="resHora") Hora
            input#resHora(type="time")
          .campo
            label(for="resEstado") Estado
            select#resEstado
              option Pendiente
              option Confirmada
              option Cancelada
        .botones
          button.boton.primario(type="button")
            | Guardar reserva
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID
              th Cliente
              th Servicio
              th Fecha
              th Hora
              th Estado
              th Acciones
          tbody
            tr
              td 1
              td Carlos Pérez
              td Sala de juegos familiar
              td 2025-12-05
              td 18:00
              td Pendiente
              td Editar | Eliminar
      // VISTA PAGOS
      section#pagos.vista
        h3 Módulo de pagos
        form.formulario
          .campo
            label(for="pagReserva") Reserva
            select#pagReserva
              option Seleccionar reserva
              option Reserva 1 - Carlos Pérez
          .campo
            label(for="pagFecha") Fecha de pago
            input#pagFecha(type="date")
          .campo
            label(for="pagMonto") Monto
            input#pagMonto(type="number", step="0.01", placeholder="0.00")
          .campo
            label(for="pagMetodo") Método de pago
            select#pagMetodo
              option Efectivo
              option Tarjeta
              option Transferencia
        .botones
          button.boton.primario(type="button") Registrar pago
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID
              th Reserva
              th Fecha
              th Monto
              th Método
              th Acciones
          tbody
            tr
              td 1
              td Reserva 1
              td 2025-12-05
              td S/ 50.00
              td Efectivo
              td Ver recibo
      // VISTA JUEGOS
      section#juegos.vista
        h3 Módulo de juegos
        form.formulario
          .campo
            label(for="jueNombre") Nombre del juego
            input#jueNombre(type="text", placeholder="Ejemplo ruleta digital")
          .campo
            label(for="jueTipo") Tipo
            select#jueTipo
              option Casino
              option Apuesta deportiva
              option Otro
          .campo(style="grid-column: 1/3")
            label(for="jueDesc") Descripción
            textarea#jueDesc(placeholder="Descripción del juego")
        .botones
          button.boton.primario(type="button") Guardar juego
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID
              th Juego
              th Tipo
              th Acciones
          tbody
            tr
              td 1
              td Ruleta digital
              td Casino
              td Editar | Eliminar
      // VISTA TRANSACCIONES
      section#transacciones.vista
        h3 Módulo de transacciones de juego
        form.formulario
          .campo
            label(for="trCliente") Cliente
            select#trCliente
              option Seleccionar cliente
              option Carlos Pérez
          .campo
            label(for="trJuego") Juego
            select#trJuego
              option Seleccionar juego
              option Ruleta digital
          .campo
            label(for="trApostado") Monto apostado
            input#trApostado(type="number", step="0.01")
          .campo
            label(for="trGanado") Monto ganado
            input#trGanado(type="number", step="0.01")
          .campo
            label(for="trResultado") Resultado
            select#trResultado
              option Ganó
              option Perdió
          .campo
            label(for="trFechaHora") Fecha y hora
            input#trFechaHora(type="datetime-local")
        .botones
          button.boton.primario(type="button")
            | Registrar transacción
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID
              th Cliente
              th Juego
              th Monto apostado
              th Monto ganado
              th Resultado
              th Fecha y hora
          tbody
            tr
              td 1
              td Carlos Pérez
              td Ruleta digital
              td S/ 10.00
              td S/ 0.00
              td Perdió
              td 2025-12-05 19:30
      // VISTA PROMOCIONES
      section#promociones.vista
        h3 Módulo de promociones
        form.formulario
          .campo
            label(for="proNombre") Nombre de la promoción
            input#proNombre(type="text", placeholder="Ejemplo dos por uno en fichas")
          .campo
            label(for="proTipo") Tipo
            input#proTipo(type="text", placeholder="Descuento, puntos extra, etc")
          .campo
            label(for="proInicio") Fecha de inicio
            input#proInicio(type="date")
          .campo
            label(for="proFin") Fecha de fin
            input#proFin(type="date")
          .campo(style="grid-column: 1/3")
            label(for="proDesc") Descripción
            textarea#proDesc(placeholder="Detalle de la promoción")
        .botones
          button.boton.primario(type="button")
            | Guardar promoción
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID
              th Promoción
              th Tipo
              th Inicio
              th Fin
          tbody
            tr
              td 1
              td Dos por uno en fichas
              td Bonificación
              td 2025-12-01
              td 2025-12-31
      // VISTA RECLAMOS
      section#reclamos.vista
        h3 Módulo de reclamos
        form.formulario
          .campo
            label(for="recCliente") Cliente
            select#recCliente
              option Seleccionar cliente
              option Carlos Pérez
          .campo
            label(for="recPersonal") Personal asignado
            select#recPersonal
              option Seleccionar personal
              option Juan Torres
          .campo
            label(for="recFecha") Fecha
            input#recFecha(type="date")
          .campo
            label(for="recEstado") Estado
            select#recEstado
              option Abierto
              option En proceso
              option Cerrado
          .campo(style="grid-column: 1/3")
            label(for="recDesc") Descripción del reclamo
            textarea#recDesc(placeholder="Detalle del reclamo")
        .botones
          button.boton.primario(type="button")
            | Guardar reclamo
          button.boton.secundario(type="button") Limpiar
        table
          thead
            tr
              th ID
              th Cliente
              th Personal
              th Fecha
              th Estado
          tbody
            tr
              td 1
              td Carlos Pérez
              td Juan Torres
              td 2025-12-05
              td Abierto
      // VISTA PERSONAL Y AUDITORÍA (USUARIOS)
      section#personal.vista
        h3 Módulo de usuarios del sistema y auditoría
        h4(style="margin-top: 10px; margin-bottom: 8px") Usuario
        form.formulario
          .campo
            label(for="admNombre") Nombre
            input#admNombre(type="text")
          .campo
            label(for="admApellido") apellido
            input#admApellido(type="text")
          .campo
            label(for="admUsuario") Usuario
            input#admUsuario(type="text")
          .campo
            label(for="admContra") Contraseña
            input#admContra(type="password")
          .campo
            label(for="admRol") Rol
            input#admRol(type="text", placeholder="operador,supervisor, etc")
          .campo
            label(for="perCargo") Cargo
            input#perCargo(type="text", placeholder="General,gerencia TI, etc")
        .botones
          button.boton.primario(type="button")
            | Guardar Usuario
          button.boton.secundario(type="button") Limpiar
        h4(style="margin-top: 18px; margin-bottom: 8px")
          | Registro de auditoría
        table
          thead
            tr
              th ID
              th Acción
              th Fecha y hora
              th Personal
              th Usuario
          tbody
            tr
              td 1
              td Registro de nuevo cliente
              td 2025-12-05 18:15
              td Juan Torres
              td Usuario 1
  script.
    // cambio de vistas
    const botones = document.querySelectorAll(".menu button");
    const vistas = document.querySelectorAll(".vista");

    botones.forEach((boton) => {
      boton.addEventListener("click", () => {
        const destino = boton.getAttribute("data-vista");

        botones.forEach((b) => b.classList.remove("activo"));
        boton.classList.add("activo");

        vistas.forEach((v) => {
          if (v.id === destino) {
            v.classList.add("activa");
          } else {
            v.classList.remove("activa");
          }
        });

        const titulo = document.querySelector("header h2");
        if (destino === "dashboard") {
          titulo.textContent = "Panel principal";
        } else {
          titulo.textContent = "Módulo " + destino;
        }
      });
    });